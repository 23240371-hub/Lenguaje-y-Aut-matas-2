Alfabetos:

Letras: a - z - A - Z

Números: 1, 2, 3, 4, 5, 6, 7, 8, 9, 0

Operadores: +, -, *,  /, =

Delimitadores: (, ), {, }, ;, ", ", 

Palabras reservadas: int, float, boolean, double, print, main, class, if, else, while

Ejemplo: 

class{
    int x = 1;
    int y = 2;
    int z = 0;

    main{
        z = x + y;
        print(z);
    } 
}


